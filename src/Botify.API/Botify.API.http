@baseurl = https://localhost:7257
@contentType = application/json

### Register
### Register a new merchant
POST {{baseurl}}/api/auth/register
Content-Type: application/json

{
  "email": "owner@myshop.com",
  "password": "StrongPass123!",
  "phone": "+201234567890",
  "firstName": "Reda",
  "lastName": "Ahmed",
  "bio": "Merchant owner using Botify platform",
  "profileImageUrl": "https://cdn.example.com/profiles/reda.png",
  "language": "en",
  "merchantName": "MyShop",
  "industry": "Retail",
  "logoUrl": "https://cdn.example.com/logos/myshop.png"
}

### Example of invalid request (missing email)
POST {{baseurl}}/api/auth/register
Content-Type: application/json

{
  "password": "StrongPass123!",
  "phone": "+201234567890",
  "firstName": "Reda",
  "lastName": "Ahmed",
  "merchantName": "MyShop",
  "industry": "Retail"
}



### Login
POST {{baseurl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "owner@myshop.com",
  "password": "StrongPass123!"
}

### Refresh Token
POST {{baseurl}}/api/auth/refresh
Content-Type: {{contentType}}

{
  "refreshToken": "PUT_REFRESH_TOKEN_HERE"
}

