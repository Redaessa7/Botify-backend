@baseurl = https://localhost:7257
@contentType = application/json

### Register
# ### Register a new merchant
# POST {{baseurl}}/api/auth/register
# Content-Type: application/json

# {
#   "email": "owner@myshop.com",
#   "password": "StrongPass123!",
#   "phone": "+201234567890",
#   "firstName": "",
#   "lastName": "gdgf",
#   "bio": "Merchant owner using Botify platform",
#   "profileImageUrl": "https://cdn.example.com/profiles/reda.png",
#   "language": "en",
#   "merchantName": "MyShop",
#   "industry": "Retail",
#   "logoUrl": "https://cdn.example.com/logos/myshop.png"
# }


####

POST {{baseurl}}/api/auth/register
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="email"

owner@myshop.com
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="password"

StrongPass123!
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="phone"

+201234567890
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="firstName"

Reda
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="lastName"

Gdfg
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="bio"

Merchant owner using Botify platform
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="language"

en
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="merchantName"

MyShop
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="industry"

Retail
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="profileImage"; filename="profile.png"
Content-Type: image/png

<@profile.png> 
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="logo"; filename="logo.png"
Content-Type: image/png

<@logo.png>
------WebKitFormBoundary7MA4YWxkTrZu0gW--


### Example of invalid request (missing email)
POST {{baseurl}}/api/auth/register
Content-Type: application/json

{
  "password": "StrongPass123!",
  "phone": "+201234567890",
  "firstName": "Reda",
  "lastName": "Ahmed",
  "merchantName": "MyShop",
  "industry": "Retail"
}



### Login
POST {{baseurl}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "owner@myshop.com",
  "password": "StrongPass123!"
}

### user info
GET {{baseurl}}/api/auth/user

### Refresh Token
POST {{baseurl}}/api/auth/refresh-token
###
GET {{baseurl}}/api/merchants/me
### Logout
POST {{baseurl}}/api/auth/logout