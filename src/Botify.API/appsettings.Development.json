{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.AspNetCore" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Botify.API"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=BotifyDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Redis": "localhost:6379"
  },
  "JWTOptions": {
    "Issuer": "https://api.botify.com",
    "Audience": "https://botify.com",
    "TokenExpirationInMinutes": 20,
    "RefreshTokenExpirationInDays": 7, 
    "SecurityKey": "e2c940f58ca8e95620b3268b9396ba06f870aae066959a55397d7b8b9a8696d5"
  },
  "CorsOptions": {
    "CorsPolicyName": "DevCors",
    "AllowedOrigins": [
      "http://localhost:8080",
      "http://localhost:7070",
      "http://localhost:7172"
    ]
  },
  "SmtpSettings": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "EnableSsl": true,
    "From": "teamaramm@gmail.com",
    "Username": "teamaramm@gmail.com",
    "Password": "txde ajxj qubw fzbt"
  },
  "PaginationOptions": {
    "DefaultLimit": 10,
    "MaxLimit": 100
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowInSeconds": 60,
      "QueueLimit": 10
    }
  },
  "AllowedHosts": "*"
}